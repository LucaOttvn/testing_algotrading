//@version=6

import lucaOttvn/fib_theme/5 as fib_theme
import lucaOttvn/day_levels_lib/4 as day_levels_lib

indicator(
     "3-Candle Gap Zones + Bullish Gap Fibonacci",
     overlay = true,
     max_boxes_count = 500,
     max_lines_count = 500
)

// set how many bars the indicator have to check back in time
lookbackBars = input.int(
     600,
     "Lookback bars",
     minval = 3
)

// show/hide bullish Fibonacci
showBullishFib = input.bool(
     true,
     "Show Fibonacci for bullish gaps"
)

// tradingView has object limits.
// each Fibonacci structure uses 7 lines and 6 background boxes.
maxFibSets = input.int(
     40,
     "Maximum amount of Fibonacci structures, the oldest one get garbage collected",
     minval = 1,
     maxval = 60
)

// opening window in minutes
openingMinutes = input.int(
     15,
     "Ignore first minutes of day to avoid extreme volatility",
     minval = 0
)


// ------------ DAY MAX AND MIN SECTION ------------

isNewDay = ta.change(time("D")) != 0

levels    = day_levels_lib.getDayLevels(isNewDay)
float dayHigh = levels.dayHigh
float dayLow  = levels.dayLow

plot(dayHigh, "Day Body High", color = color.yellow, linewidth = 4)
plot(dayLow,  "Day Body Low",  color = color.blue,   linewidth = 4)

// ------------------------------------------------


dayStart = time("D")
openingEnd = dayStart + openingMinutes * 60 * 1000

// the candles included in the opening period must be ignored
// check if both the current and the 3rd candle are over the opening period
afterOpeningPeriod =
     time >= openingEnd and
     not na(time[2]) and
     time[2] >= openingEnd

// --- lookback and candle availability ---
inLookback = bar_index >= last_bar_index - lookbackBars + 1
enoughBars = bar_index >= 2

// high shadows
c1High = high[2]
c3High = high

// low shadows
c1Low = low[2]
c3Low = low

// check if: 
// - there are enough candles
// - the current candle is included in the lookback amount of candles to check
// - the first 15 minutes of the day have passed
// these conditions are needed for both the bullish and bearish gaps
generalConditions = enoughBars and inLookback and afterOpeningPeriod 

// - the gap exists
// - the 3rd candle's close breaks the dayHigh
// - the 3rd candle is big enough to be considered
bullishGap =
     generalConditions and
     c3Low > c1High and
     close >= dayHigh and
     close - open > 0.5

// check if: 
// - the gap exists
// - the 3rd candle's close breaks the dayLow
// - the 3rd candle is big enough to be considered
bearishGap =
     generalConditions and
     c3High < c1Low and
     close <= dayLow and
     open - close > 0.5

// draw bullish gap zone
if bullishGap
    box.new(
         left = bar_index - 2,
         right = bar_index,
         top = c3Low,
         bottom = c1High,
         bgcolor = color.new(color.green, 65),
         border_color = na
    )

// draw bearish gap zone
if bearishGap
    box.new(
         left = bar_index - 2,
         right = bar_index,
         top = c1Low,
         bottom = c3High,
         bgcolor = color.new(color.red, 65),
         border_color = na
    )


// ------------ FIBONACCI SECTION ------------

// Fibonacci object storage
var array<line> fibLines = array.new_line()
var array<box> fibBoxes = array.new_box()

// Fibonacci levels
var array<float> fibRatios = array.from(
     0.000,
     0.500,
     0.618,
     0.786,
     1.000
)

// corresponding line colors
var array<color> fibLineColors = array.from(
     fib_theme.fibColor0,
     fib_theme.fibColor0500,
     fib_theme.fibColor0618,
     fib_theme.fibColor0786,
     fib_theme.fibColor1000
)

// TEMP
// var array<float> startingPrices = array.new_float()
var float level0618 = na

// draw Fibonacci for valid bullish gaps
if showBullishFib and bullishGap and not na(dayLow) and not na(dayHigh)

    dailyRange = dayHigh - dayLow

    fibStartBar = bar_index
    
    // set the Fibonacci indicator's length starting from the current index
    fibEndBar = bar_index + 50
    
    // calculate Fibonacci prices.
    level0 = dayLow
    level0500 = dayLow + dailyRange * 0.500
    level0618 := dayLow + dailyRange * 0.618
    level0786 = dayLow + dailyRange * 0.786
    level1000 = dayHigh

    if low < level0618
        // Create one label for this new price
        label.new(
            x = bar_index,
            y = level0618,
            text = "Saved price: " + str.tostring(close),
            style = label.style_label_down,
            color = color.new(#28602a, 0),
            textcolor = color.white
        )

    // red section
    array.push(fibBoxes, box.new(
         left = fibStartBar,
         right = fibEndBar,
         top = level0500,
         bottom = level0,
         xloc = xloc.bar_index,
         bgcolor = color.new(fib_theme.fibFill0To0500, 75),
         border_color = na
    ))
    
    // orange section
    array.push(fibBoxes, box.new(
         left = fibStartBar,
         right = fibEndBar,
         top = level0618,
         bottom = level0500,
         xloc = xloc.bar_index,
         bgcolor = color.new(fib_theme.fibFill0500To0618, 75),
         border_color = na
    ))
    
    // blue section
    array.push(fibBoxes, box.new(
         left = fibStartBar,
         right = fibEndBar,
         top = level0786,
         bottom = level0618,
         xloc = xloc.bar_index,
         bgcolor = color.new(fib_theme.fibFill0618To0786, 75),
         border_color = na
    ))
    
    // white section
    array.push(fibBoxes, box.new(
         left = fibStartBar,
         right = fibEndBar,
         top = level1000,
         bottom = level0786,
         xloc = xloc.bar_index,
         bgcolor = color.new(fib_theme.fibFill0786To1000, 75),
         border_color = na
    ))
    
    // Fibonacci horizontal lines
    for i = 0 to array.size(fibRatios) - 1

        ratio = array.get(fibRatios, i)
        levelColor = array.get(fibLineColors, i)
        levelPrice = dayLow + dailyRange * ratio
        levelLine = line.new(
             x1 = fibStartBar,
             y1 = levelPrice,
             x2 = fibEndBar,
             y2 = levelPrice,
             xloc = xloc.bar_index,
             color = levelColor,
             width = 2,
             style = line.style_solid
        )
        
        array.push(fibLines, levelLine)

if low < level0618
    label.new(
        x = bar_index,
        y = low,
        text = "Open long position",
        style = label.style_label_up,
        color = color.new(#28602a, 0),
        textcolor = color.white
    )
    level0618 := na