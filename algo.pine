//@version=6

import lucaOttvn/fib_theme/5 as fib_theme
import lucaOttvn/day_levels_lib/4 as day_levels_lib

indicator(
     "3-Candle Gap Zones + Bullish Gap Fibonacci",
     overlay = true,
     max_boxes_count = 500,
     max_lines_count = 500
)

// --- inputs ---
lookbackBars = input.int(
     999999,
     "Lookback bars",
     minval = 3
)

// --- gap colors ---
bullColor = input.color(
     color.new(color.green, 65),
     "Bullish gap color"
)

bearColor = input.color(
     color.new(color.red, 65),
     "Bearish gap color"
)

// --- fibonacci settings ---
showBullFib = input.bool(
     false,
     "Show Fibonacci for bullish gaps"
)

fibLengthBars = input.int(
     10,
     "Fibonacci maximum length",
     minval = 0,
     maxval = 20
)

fibWidth = input.int(
     2,
     "Fibonacci line width",
     minval = 1,
     maxval = 4
)

fibLineStyleInput = input.string(
     "Solid",
     "Fibonacci line style",
     options = ["Solid", "Dashed", "Dotted"]
)

fibTransparency = input.int(
     75,
     "Fibonacci background transparency",
     minval = 0,
     maxval = 95
)

// tradingView has object limits.
// each Fibonacci structure uses 7 lines and 6 background boxes.
maxFibSets = input.int(
     40,
     "Maximum Fibonacci structures",
     minval = 1,
     maxval = 60
)

// --- opening period filter ---
openingMinutes = input.int(
     15,
     "Ignore first minutes of day to avoid extreme volatility",
     minval = 0
)

// --- running daily high and low ---
isNewDay = ta.change(time("D")) != 0

levels    = day_levels_lib.getDayLevels(isNewDay)
float dayHigh = levels.dayHigh
float dayLow  = levels.dayLow

plot(dayHigh, "Day Body High", color = color.yellow, linewidth = 4)
plot(dayLow,  "Day Body Low",  color = color.blue,   linewidth = 4)

dayStart = time("D")
openingEnd = dayStart + openingMinutes * 60 * 1000

// Candle 3 and candle 1 must both be after the opening period.
// This avoids detecting patterns that started during the first 15 minutes.
afterOpeningPeriod =
     time >= openingEnd and
     not na(time[2]) and
     time[2] >= openingEnd

// --- lookback and candle availability ---
inLookback = bar_index >= last_bar_index - lookbackBars + 1
enoughBars = bar_index >= 2

// high shadows
c1High = high[2]
c3High = high

// low shadows
c1Low = low[2]
c3Low = low

// check if: 
// - there are enough candles
// - the first 15 minutes of the day have passed
// - the gap exists
// - the 3rd candle's close breaks the dayHigh
// - the 3rd candle is big enough to be considered
bullishGapRaw =
     enoughBars and
     afterOpeningPeriod and
     c3Low > c1High and
     close >= dayHigh and
     close - open > 0.5

// check if: 
// - there are enough candles
// - the first 15 minutes of the day have passed
// - the gap exists
// - the 3rd candle's close breaks the dayLow
// - the 3rd candle is big enough to be considered
bearishGapRaw =
     enoughBars and
     afterOpeningPeriod and
     c3High < c1Low and
     close <= dayLow and
     open - close > 0.5

bullishGap =
     inLookback and
     bullishGapRaw

bearishGap =
     inLookback and
     bearishGapRaw

// draw bullish gap zone
if bullishGap
    box.new(
         left = bar_index - 2,
         right = bar_index,
         top = c3Low,
         bottom = c1High,
         bgcolor = bullColor,
         border_color = na
    )

// draw bearish gap zone
if bearishGap
    box.new(
         left = bar_index - 2,
         right = bar_index,
         top = c1Low,
         bottom = c3High,
         bgcolor = bearColor,
         border_color = na
    )

// Fibonacci object storage
var array<line> fibLines = array.new_line()
var array<box> fibBoxes = array.new_box()

// Fibonacci levels
var array<float> fibRatios = array.from(
     0.000,
     0.500,
     0.618,
     0.786,
     1.000,
     1.272,
     1.618
)

// corresponding line colors
var array<color> fibLineColors = array.from(
     fib_theme.fibColor0,
     fib_theme.fibColor0500,
     fib_theme.fibColor0618,
     fib_theme.fibColor0786,
     fib_theme.fibColor1000,
     fib_theme.fibColor1272,
     fib_theme.fibColor1618
)

// draw Fibonacci for valid bullish gaps
if showBullFib and bullishGap and not na(dayLow) and not na(dayHigh)

    dailyRange = dayHigh - dayLow

    if dailyRange > 0

        linesPerSet = 7
        boxesPerSet = 6

        // remove oldest Fibonacci lines.
        while array.size(fibLines) >= maxFibSets * linesPerSet
            oldestLine = array.shift(fibLines)
            line.delete(oldestLine)

        // remove oldest Fibonacci background sections.
        while array.size(fibBoxes) >= maxFibSets * boxesPerSet
            oldestBox = array.shift(fibBoxes)
            box.delete(oldestBox)

        fibStartBar = bar_index
        fibEndBar = bar_index + fibLengthBars

        // calculate Fibonacci prices.
        level0 = dayLow
        level0500 = dayLow + dailyRange * 0.500
        level0618 = dayLow + dailyRange * 0.618
        level0786 = dayLow + dailyRange * 0.786
        level1000 = dayHigh
        level1272 = dayLow + dailyRange * 1.272
        level1618 = dayLow + dailyRange * 1.618

        // --- background sections
        fill0To0500 = box.new(
             left = fibStartBar,
             right = fibEndBar,
             top = level0500,
             bottom = level0,
             xloc = xloc.bar_index,
             bgcolor = color.new(fib_theme.fibFill0To0500, fibTransparency),
             border_color = na
        )

        array.push(fibBoxes, fill0To0500)

        fill0500To0618 = box.new(
             left = fibStartBar,
             right = fibEndBar,
             top = level0618,
             bottom = level0500,
             xloc = xloc.bar_index,
             bgcolor = color.new(fib_theme.fibFill0500To0618, fibTransparency),
             border_color = na
        )

        array.push(fibBoxes, fill0500To0618)

        fill0618To0786 = box.new(
             left = fibStartBar,
             right = fibEndBar,
             top = level0786,
             bottom = level0618,
             xloc = xloc.bar_index,
             bgcolor = color.new(fib_theme.fibFill0618To0786, fibTransparency),
             border_color = na
        )

        array.push(fibBoxes, fill0618To0786)

        fill0786To1000 = box.new(
             left = fibStartBar,
             right = fibEndBar,
             top = level1000,
             bottom = level0786,
             xloc = xloc.bar_index,
             bgcolor = color.new(fib_theme.fibFill0786To1000, fibTransparency),
             border_color = na
        )

        array.push(fibBoxes, fill0786To1000)

        fill1000To1272 = box.new(
             left = fibStartBar,
             right = fibEndBar,
             top = level1272,
             bottom = level1000,
             xloc = xloc.bar_index,
             bgcolor = color.new(fib_theme.fibFill1000To1272, fibTransparency),
             border_color = na
        )

        array.push(fibBoxes, fill1000To1272)

        fill1272To1618 = box.new(
             left = fibStartBar,
             right = fibEndBar,
             top = level1618,
             bottom = level1272,
             xloc = xloc.bar_index,
             bgcolor = color.new(fib_theme.fibFill1272To1618, fibTransparency),
             border_color = na
        )

        array.push(fibBoxes, fill1272To1618)

        // --- Fibonacci horizontal lines ---

        for i = 0 to array.size(fibRatios) - 1

            ratio = array.get(fibRatios, i)
            levelColor = array.get(fibLineColors, i)

            levelPrice = dayLow + dailyRange * ratio

            levelLine = line.new(
                 x1 = fibStartBar,
                 y1 = levelPrice,
                 x2 = fibEndBar,
                 y2 = levelPrice,
                 xloc = xloc.bar_index,
                 color = levelColor,
                 width = fibWidth,
                 style = line.style_solid
            )

            array.push(fibLines, levelLine)
