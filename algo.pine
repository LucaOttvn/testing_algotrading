//@version=6

import lucaOttvn/day_levels_lib/16 as day_levels_lib

indicator(
     "3-Candle Gap Zones + Bullish Gap Fibonacci",
     overlay = true,
     max_boxes_count = 500,
     max_lines_count = 500
)

// set how many bars the indicator have to check back in time
lookbackBars = input.int(
     999999,
     "Lookback bars",
     minval = 3
)

// opening window in minutes
openingMinutes = input.int(
     15,
     "Ignore first minutes of day to avoid extreme volatility",
     minval = 0
)

timezone = input.string(
     "Europe/Rome",
     "Timezone",
     options = [
         "Europe/Rome",
         "Etc/UTC",
         "America/New_York",
         "America/Chicago",
         "America/Los_Angeles",
         "Asia/Tokyo",
         "Europe/London"
     ]
)


bullishGapColor = input.color(color.blue)

thresholdHour = input.int(18, "Hour threshold (0-23)", minval = 0, maxval = 23)

// ------------ DAY MAX AND MIN SECTION ------------

isNewDay = ta.change(time("D")) != 0

levels    = day_levels_lib.getDayLevels(isNewDay)
float dayHigh = levels.dayHigh
float dayLow  = levels.dayLow

plot(dayHigh, "Day Body High", color = color.white, linewidth = 2)
plot(dayLow,  "Day Body Low",  color = color.white,   linewidth = 2)

// ------------------------------------------------


dayStart = time("D")

openingEnd = dayStart + openingMinutes * 60 * 1000

// the candles included in the opening period must be ignored
// check if both the current and the 3rd candle are over the opening period
afterOpeningPeriod =
     time >= openingEnd and
     not na(time[2]) and
     time[2] >= openingEnd

// --- lookback and candle availability ---
// high shadows
c1High = high[2]
c3High = high

// low shadows
c1Low = low[2]
c3Low = low

// - the gap exists
// - the 3rd candle's close breaks the dayHigh
// - the 3rd candle is big enough to be considered
bullishGap =
     afterOpeningPeriod and
     c3Low > c1High and
     c3Low - c1High > 0.1 and
     high >= dayHigh and
     close - open > 0.1

// check if: 
// - the gap exists
// - the 3rd candle's close breaks the dayLow
// - the 3rd candle is big enough to be considered
bearishGap =
     afterOpeningPeriod and
     c3High < c1Low and
     c1Low - c3High > 0.1 and
     high <= dayLow and
     open - close > 0.1

// draw bullish gap zone
if bullishGap
    box.new(
         left = bar_index - 2,
         right = bar_index,
         top = c3Low,
         bottom = c1High,
         bgcolor = bullishGapColor,
         border_color = na
    )

// draw bearish gap zone
if bearishGap
    box.new(
         left = bar_index - 2,
         right = bar_index,
         top = c1Low,
         bottom = c3High,
         bgcolor = color.new(color.red, 65),
         border_color = na
    )


// ------------ FIBONACCI SECTION ------------

currentHour = hour(time, timezone)

// this bool tells if we currently are in a Fibonacci area or not
var bool insideFibArea = false

// when a valid gap is found and we are not in a Fibonacci area already, mark the beginning of a new Fibonacci area
if bullishGap and not insideFibArea
    insideFibArea := true
    
plot(
    insideFibArea ? levels.redLine : na,
    "Fibonacci red line",
    color = color.red,
    linewidth = 2,
    style = plot.style_linebr
)

plot(
    insideFibArea ? levels.orangeLine : na,
    "Fibonacci orange line",
    color = color.orange,
    linewidth = 2,
    style = plot.style_linebr
)

plot(
    insideFibArea ? levels.aquaLine : na,
    "Fibonacci aqua line",
    color = color.aqua,
    linewidth = 2,
    style = plot.style_linebr
)


// ------------ OPERATION SECTION ------------

// bool to check if there currently is an opened position
var float openedPosition = na

if insideFibArea and low < levels.orangeLine and na(openedPosition) and afterOpeningPeriod

    // reset the opened position check
    openedPosition := close

    box.new(
        left = bar_index,
        right = bar_index + 100,
        top = levels.orangeLine,
        bottom = levels.orangeLine - (levels.orangeLine * 0.01),
        bgcolor = color.new(color.red, 80),
        border_color = color.red,
        border_width = 1
    )

    box.new(
        left = bar_index,
        right = bar_index + 100,
        top = levels.orangeLine,
        bottom = levels.orangeLine + (levels.orangeLine * 0.01),
        bgcolor = color.new(color.green, 80),
        border_color = color.green,
        border_width = 1
    )

// stop drawing Fibonacci if the treshold hour has passed or the day ended
if currentHour >= thresholdHour or isNewDay
    insideFibArea := false

// at the end of the day close the open position (if there's one)
if isNewDay
    openedPosition := na

